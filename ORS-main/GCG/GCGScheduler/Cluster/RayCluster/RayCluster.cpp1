Init_HTTPedMiniGCGMaster_RayCluster(int port) {
    Create_Master_Actor(HTTPedMiniGCGMaster_ActorCreator, port);
    Create_Accs_Actor(NR_STREAM);
}

static MasterActor *
HTTPedBigLockGCGMaster_ActorCreator(Rank rank, std::string master_ip, size_t world_size, int port) {
    return new MasterActor(WrapHTTPedMaster(GetBigLockMaster(), port), rank, master_ip, world_size);
}
RAY_REMOTE(HTTPedBigLockGCGMaster_ActorCreator);

void
Init_HTTPedBigLockGCGMaster_RayCluster(int port) {
    Create_Master_Actor(HTTPedBigLockGCGMaster_ActorCreator, port);
    Create_Accs_Actor(NR_STREAM);
}

